#!/usr/bin/env python3
# lerd rust plugin: the last build, for the CLI, MCP and API.
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from lerd_rust import status as entry  # noqa: E402

sys.exit(entry.status_main(sys.argv[1:]))

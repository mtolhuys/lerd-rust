#!/usr/bin/env python3
# lerd rust plugin: the dev server that rebuilds on save (lerd rust:dev).
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from lerd_rust import watcher as entry  # noqa: E402

sys.exit(entry.main(sys.argv[1:]))

#!/usr/bin/env python3
# lerd rust plugin: point .lerd.yaml at lerd rust:dev (lerd rust:setup).
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from lerd_rust import setup as entry  # noqa: E402

sys.exit(entry.main(sys.argv[1:]))
